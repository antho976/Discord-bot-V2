# Copy to bot.env on the server, fill in from Render's Environment tab, then `chmod 600 bot.env`.
# README, "Environment", explains each one.

DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
OWNER_ID=

# The dashboard's public address through the Cloudflare Tunnel, no trailing slash.
# Relay's address follows from it (wss://<host>/relay) unless RELAY_PUBLIC_URL is set.
PUBLIC_URL=https://bot.example.com

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Reuse Render's value; any random 10 to 100 characters works.
TWITCH_EVENTSUB_SECRET=
