# The container's one public port (Render's $PORT): Relay's rendezvous under /relay, the bot and
# its dashboard everywhere else. Render ends TLS in front of this, so phones dial wss://<host>/relay.
{
	admin off
	auto_https off
	persist_config off
	# Render's edge proxy connects from a private address. Trusting private ranges keeps the
	# X-Forwarded-For it sends (with the real client address) instead of replacing it, so the bot
	# can rate-limit by client. The bot reads the rightmost public address in the header.
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT} {
	# Strips /relay: the rendezvous serves /host/<room>, /join/<room> and /health.
	# WebSockets pass through reverse_proxy as they are, with no idle timeout.
	handle_path /relay/* {
		reverse_proxy 127.0.0.1:7430
	}
	handle {
		reverse_proxy 127.0.0.1:3001
	}
}
